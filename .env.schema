# Homepage Dashboard Environment Variables Schema

# Balance Proxy URL
BALANCE_PROXY_URL=https://homepagehelper.thecreems.com

# Varlock Configuration for Infisical
VARLOCK_ENABLED=true
VARLOCK_INFISICAL_PROJECT_ID=your_infisical_project_id
VARLOCK_INFISICAL_ENV=production

# API Keys for Balance Monitoring (managed by Varlock/Infisical)
RUNPOD_API_KEY=your_runpod_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROK_API_KEY=your_grok_api_key_here
VENICE_API_ADMIN_KEY=your_venice_admin_api_key_here

# Homepage Dashboard Environment Variables Schema

# Load Varlock Infisical plugin
@plugin(@varlock/infisical-plugin)

# Initialize Infisical connection
@initInfisical(
  projectId=$INFISICAL_PROJECT_ID,
  environment=$INFISICAL_ENV,
  clientId=$INFISICAL_CLIENT_ID,
  clientSecret=$INFISICAL_CLIENT_SECRET
)

# --- Infisical Machine Identity Credentials ---
@type=infisicalClientId
INFISICAL_CLIENT_ID=

@type=infisicalClientSecret @sensitive
INFISICAL_CLIENT_SECRET=

# --- Secrets fetched from Infisical ---
# Balance Proxy URL (optional in Infisical, defaults if not set)
BALANCE_PROXY_URL=https://homepagehelper.thecreems.com

# API Keys for Balance Monitoring
@type=infisicalSecret @sensitive
RUNPOD_API_KEY=

@type=infisicalSecret @sensitive
OPENAI_API_KEY=

@type=infisicalSecret @sensitive
GROK_API_KEY=

@type=infisicalSecret @sensitive
VENICE_API_ADMIN_KEY=

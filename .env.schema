# Homepage Dashboard Environment Variables Schema

# Load Varlock Infisical plugin
# @plugin(@varlock/infisical-plugin@0.0.6)

# Initialize Infisical connection
# @initInfisical(
#   projectId=$INFISICAL_PROJECT_ID,
#   environment=$INFISICAL_ENVIRONMENT,
#   clientId=$INFISICAL_UNIVERSAL_AUTH_CLIENT_ID,
#   clientSecret=$INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET,
#   siteUrl=https://infisical.thecreems.com,
#   secretPath=/external_services
# )

# ---

# --- Infisical Configuration ---
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=
INFISICAL_API_URL=

BALANCE_PROXY_URL=

# --- Infisical Machine Identity Credentials ---
# @type=infisicalClientId
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=

# @type=infisicalClientSecret @sensitive
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=

# --- Secrets fetched from Infisical (from external_services folder) ---
# @sensitive
VENICE_API_ADMIN_KEY=infisical()
